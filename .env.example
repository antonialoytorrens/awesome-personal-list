# Required on first run only, to seed the single admin account (there is no
# /register route). Ignored once an admin already exists.
AWESOME_PERSONAL_LIST_ADMIN_USER=test
AWESOME_PERSONAL_LIST_ADMIN_PASSWORD=test

# Optional. Defaults: 127.0.0.1:48889
AWESOME_PERSONAL_LIST_BIND=127.0.0.1
AWESOME_PERSONAL_LIST_PORT=48889

# Optional. Raises the Software Heritage API rate limit for the checker.
SWH_API_TOKEN=

# Optional. Output path for `make export` (default: AWESOME.md).
EXPORT_PATH=AWESOME.md
